# Rename this file to .env and fill in your real values.
# NEVER commit or share your real .env file publicly.

# Get this from @BotFather on Telegram after running /newbot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your channel's @username (e.g. @nuro_channel) OR its numeric chat ID
TELEGRAM_CHANNEL_ID=@your_channel_username

# Get this from https://console.anthropic.com (used to translate/simplify papers)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Hour (24h, in your local timezone) the bot posts daily content. Example: 7 = 7 AM
POST_HOUR=7
POST_MINUTE=0

# Timezone, e.g. Asia/Tashkent
TIMEZONE=Asia/Tashkent
